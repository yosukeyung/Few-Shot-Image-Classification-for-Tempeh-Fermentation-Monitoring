# TempeClassify Environment Variables
# Copy this file to .env and fill in your actual values

# ============================
# SUPABASE CONFIGURATION
# ============================
# Get these from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_SUPABASE_ANON_KEY

# ============================
# HUGGINGFACE SPACES API
# ============================
# After deploying the api/ folder to HuggingFace Spaces, set your Space URL here
# Format: https://YOUR_HF_USERNAME-tempeclassify.hf.space
VITE_HF_API_URL=https://YOUR_HF_USERNAME-YOUR_SPACE_NAME.hf.space

# For local development, you can use the local uvicorn server:
# VITE_HF_API_URL=http://localhost:8000
